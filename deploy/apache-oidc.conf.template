<VirtualHost 82.165.32.162:443>
    ServerName circuit-lab.christopherrehm.de
    SSLEngine on
    SSLCertificateFile /etc/letsencrypt/live/circuit-lab.christopherrehm.de/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/circuit-lab.christopherrehm.de/privkey.pem
    Include /etc/letsencrypt/options-ssl-apache.conf
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Cache-Control "no-store"
    LimitRequestBody 8192
    ProxyRequests Off
    ProxyPreserveHost On
    ProxyTimeout 25
    RequestHeader unset X-Circuit-Proxy-Token
    RequestHeader unset X-Circuit-Actor
    RequestHeader unset X-Circuit-Email
    RequestHeader unset X-Circuit-Access-Token
    RequestHeader unset X-Forwarded-User
    RequestHeader unset X-Forwarded-Email
    RequestHeader unset X-Forwarded-Preferred-Username
    RequestHeader set X-Forwarded-Proto "https"
    RequestHeader set X-Forwarded-Host "circuit-lab.christopherrehm.de"
    <LocationMatch "^/auth/(admin|realms/master)(/|$)">
        Require all denied
    </LocationMatch>
    ProxyPass /auth/ http://127.0.0.1:8104/auth/
    ProxyPassReverse /auth/ http://127.0.0.1:8104/auth/
    ProxyPass /oauth2/ http://127.0.0.1:8103/oauth2/
    ProxyPassReverse /oauth2/ http://127.0.0.1:8103/oauth2/
    # MCP carries its own verified OAuth bearer: no browser-login redirect.
    <Location /mcp>
        LimitRequestBody 65536
    </Location>
    <Location /api/projects>
        LimitRequestBody 16384
    </Location>
    ProxyPass /.well-known/oauth-protected-resource/mcp http://127.0.0.1:8102/.well-known/oauth-protected-resource/mcp
    ProxyPassReverse /.well-known/oauth-protected-resource/mcp http://127.0.0.1:8102/.well-known/oauth-protected-resource/mcp
    ProxyPass /mcp http://127.0.0.1:8102/mcp
    ProxyPassReverse /mcp http://127.0.0.1:8102/mcp
    ProxyPass /workbench http://127.0.0.1:8103/workbench
    ProxyPassReverse /workbench http://127.0.0.1:8103/workbench
    ProxyPass /api/ http://127.0.0.1:8103/api/
    ProxyPassReverse /api/ http://127.0.0.1:8103/api/
    ProxyPass /assets/ http://127.0.0.1:8103/assets/
    ProxyPassReverse /assets/ http://127.0.0.1:8103/assets/
    DocumentRoot /var/www/circuit-lab-public
    DirectoryIndex landing.html
    <Directory /var/www/circuit-lab-public>
        Options -Indexes
        AllowOverride None
        Require all granted
    </Directory>
    <LocationMatch "^/(landing.html|landing.css)?$">
        Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://stats.christopherrehm.de/script.js; connect-src 'self' https://stats.christopherrehm.de/api/send; style-src 'self'; img-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    </LocationMatch>
    ErrorLog ${APACHE_LOG_DIR}/circuit-lab-error.log
    CustomLog ${APACHE_LOG_DIR}/circuit-lab-access.log combined
</VirtualHost>
