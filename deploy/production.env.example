CIRCUIT_PUBLIC_URL=https://circuit-lab.christopherrehm.de
CIRCUIT_PORT=8102
CIRCUIT_ACCESS_MODE=private
# Generate a fresh secret on the VPS; never commit the real environment file.
CIRCUIT_PROXY_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
# Leave disabled until identity provisioning, backup/restore and Codex linking are verified.
CIRCUIT_ENABLE_PROJECTS=false
# If enabled, use compose.projects.yaml; credentials stay only in the root-owned VPS env.
# CIRCUIT_APPLICATION_DATABASE_PASSWORD=<fresh-URL-safe-secret>
# CIRCUIT_DATABASE_URL=postgresql://circuit_application:<same-secret>@application-db:5432/circuit_application
# CIRCUIT_MCP_INTROSPECTION_SECRET=<different-fresh-secret>
# CIRCUIT_MCP_CLIENTS=circuit-lab-codex
