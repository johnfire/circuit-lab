{
  "name": "circuit-lab-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src public/landing-analytics.js",
    "test:unit": "node --test tests/*.test.cjs tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:projects": "playwright test --config playwright.projects.config.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2"
  }
}
