{
  "id": "pi_relay_driver",
  "name": "Relay or solenoid driver",
  "category": "switching",
  "description": "Pi GPIO17 switches a 12 V coil (400 Ω, 100 mH) through a logic-level IRLZ44N, with a 1N5819 flyback diode, 100 Ω gate resistor and 100 kΩ pull-down.",
  "notes": "Delete the flyback diode and simulate to see the drain spike fail the MOSFET's rating.",
  "expectations": [
    {
      "signal": "I:LC",
      "statistic": "max",
      "value": 0.03,
      "tolerance": 0.002,
      "meaning": "coil current reaches 12 V / 400 Ω = 30 mA"
    },
    {
      "signal": "V:Q1:0",
      "statistic": "max",
      "value": 12.3,
      "tolerance": 0.4,
      "meaning": "the flyback diode clamps the drain near 12 V"
    }
  ],
  "circuit": {
