{
  "id": "five_volt_to_pi_divider",
  "name": "5 V signal into a Pi pin",
  "category": "interfacing",
  "description": "A 10 kΩ / 20 kΩ divider brings a 0–5 V sensor output to 3.33 V for a Pi GPIO input.",
  "notes": "Fine for slow signals; for fast or bidirectional lines use the BSS138 level shifter.",
