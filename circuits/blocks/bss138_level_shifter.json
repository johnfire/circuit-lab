{
  "id": "bss138_level_shifter",
  "name": "I2C level shifter (3.3 V ↔ 5 V)",
  "category": "interfacing",
  "description": "The classic BSS138 bidirectional shifter: Pi GPIO2 (SDA, 1.8 kΩ board pull-up) on the low side, a 10 kΩ pull-up to 5 V on the high side.",
  "notes": "Here the Pi pin pulses as if sending data; watch the 5 V side follow. Use one per I2C line.",
  "expectations": [
    {
      "signal": "V:Q1:0",
      "statistic": "max",
      "value": 5.0,
      "tolerance": 0.05,
      "meaning": "the 5 V side goes high when the Pi side is high"
    },
    {
      "signal": "V:Q1:0",
      "statistic": "min",
      "value": 0.2,
      "tolerance": 0.15,
      "meaning": "the 5 V side goes low when the Pi side is low"
    }
  ],
  "circuit": {
    "parts": [
      {
        "id": "P1",
        "kind": "PIN",
        "value": 0,
        "x": 4,
        "y": 10,
        "rotation": 0,
        "board_pin": {
          "board": "raspberry_pi_4",
          "pin": "3",
          "mode": "pulse"
        },
        "pulse": {
          "period": 0.0002,
          "width": 0.0001,
          "delay": 1e-05
        }
      },
      {
        "id": "P2",
        "kind": "PIN",
        "value": 0,
        "x": 10,
        "y": 3,
        "rotation": 0,
        "board_pin": {
          "board": "raspberry_pi_4",
          "pin": "1",
          "mode": "supply"
        }
      },
      {
        "id": "Q1",
        "kind": "NMOS",
        "value": 0,
        "x": 13,
        "y": 10,
        "rotation": 90,
        "device": "bss138"
      },
      {
        "id": "RH",
        "kind": "R",
        "value": 10000,
        "x": 20,
        "y": 6,
        "rotation": 90
      },
      {
        "id": "V5",
        "kind": "V",
        "value": 5,
        "x": 24,
        "y": 4,
        "rotation": 90
      },
      {
        "id": "G1",
        "kind": "GND",
        "value": 0,
        "x": 24,
        "y": 12,
        "rotation": 0
      }
    ],
    "wires": [
      {
        "a": {
          "part": "P1",
          "terminal": 0
        },
        "b": {
          "part": "Q1",
          "terminal": 2
        }
      },
      {
        "a": {
          "part": "P2",
          "terminal": 0
        },
        "b": {
          "part": "Q1",
          "terminal": 1
        }
      },
      {
        "a": {
          "part": "Q1",
          "terminal": 0
        },
        "b": {
          "part": "RH",
          "terminal": 1
        }
      },
      {
        "a": {
          "part": "RH",
          "terminal": 0
        },
        "b": {
          "part": "V5",
          "terminal": 0
        }
      },
      {
        "a": {
          "part": "V5",
          "terminal": 1
        },
        "b": {
          "part": "G1",
          "terminal": 0
        }
      }
    ],
    "timing": {
      "stop": 0.0006,
      "step": 1e-06
    }
  }
}
